#!/bin/zsh
# local-vscode — the familiar Claude Code chat panel in VS Code, but on the LOCAL model.
#
#   local-vscode work [FOLDER]   «Локальный Claude»: рабочая модель, БЕЗ интернета (клиентские файлы)
#   local-vscode lab  [FOLDER]   «Лаборатория Claude»: модель без фильтров + интернет по просьбе
#   local-vscode work|lab --setup-only   prepare the instance (extension, settings) without opening it
#
# Each runs a SEPARATE VS Code instance (own --user-data-dir and --extensions-dir under
# ~/Library/Application Support/claude-local-vscode/<work|lab>):
#  * only one extension in it — Claude Code, the same version as the pinned binary, never auto-updated;
#    no Copilot, no cloud Claude login, no Settings Sync, telemetry and crash upload off;
#  * claudeCode.claudeProcessWrapper → bin/claude-local-vscode | bin/claude-lab-vscode, i.e. every
#    Claude process of that window goes through claude-local: pinned binary, kernel sandbox, policy;
#  * the data dir lives under ~/Library — NOT writable from either sandbox (a session cannot change
#    the wrapper setting of its own window).
# The model is preloaded in the background while the window opens.

setopt ERR_EXIT NO_UNSET PIPE_FAIL

HARNESS_HOME="${0:A:h:h}"
CODE_APP="/Applications/Visual Studio Code.app"
CODE="$CODE_APP/Contents/Resources/app/bin/code"
PINNED="$HOME/.claude-local/bin/claude"
ROOT="$HOME/Library/Application Support/claude-local-vscode"

die() { print -u2 -- "✖ $*"; exit 1; }

which=${1:-}; shift 2>/dev/null || true
setup_only=0
[[ "${1:-}" == --setup-only ]] && { setup_only=1; shift; }
folder=${1:-}
case "$which" in
  work) wrapper="$HARNESS_HOME/bin/claude-local-vscode"; conf="$HOME/.claude-local"
        title="🔒 ЛОКАЛЬНО · без интернета"; bar="#14532d"; bar2="#1d3b2a" ;;
  lab)  wrapper="$HARNESS_HOME/bin/claude-lab-vscode"; conf="$HOME/.claude-local-net"
        title="🧪 ЛАБОРАТОРИЯ · интернет"; bar="#7c2d12"; bar2="#4a2216" ;;
  *)    die "использование: local-vscode work|lab [ПАПКА]" ;;
esac
[[ -x "$CODE" ]] || die "VS Code не найден в /Applications"
[[ -x "$PINNED" ]] || die "харнесс не установлен: $HARNESS_HOME/install.sh"
[[ -f "$conf/.claude.json" ]] || die "харнесс не установлен: $HARNESS_HOME/install.sh"

BASE="$ROOT/$which"; DATA="$BASE/data"; EXT="$BASE/extensions"
mkdir -p "$DATA/User" "$EXT" "$BASE/crashes"
chmod 700 "$ROOT" "$BASE" 2>/dev/null || true

# 1. Extension = exactly the pinned binary's version (copied once; the main VS Code may update its own).
ver=$("$PINNED" --version 2>/dev/null | awk '{print $1; exit}')
[[ -n "$ver" ]] || die "не удалось узнать версию закреплённого Claude Code"
ext_name="anthropic.claude-code-$ver-darwin-arm64"
if [[ ! -f "$EXT/$ext_name/package.json" ]]; then
  src="$HOME/.vscode/extensions/$ext_name"
  [[ -f "$src/package.json" ]] || die "нет расширения Claude Code $ver (ни в VS Code, ни в копии).
  Обнови закреплённую версию: claude-local --pin-binary, затем tests/verify.sh"
  rm -rf "$EXT/.tmp-$ext_name"
  /usr/bin/ditto "$src" "$EXT/.tmp-$ext_name"
  mv "$EXT/.tmp-$ext_name" "$EXT/$ext_name"
fi
/usr/bin/python3 -I - "$EXT/$ext_name/package.json" <<'PY2'
import json, os, sys
p = sys.argv[1]
d = json.load(open(p, encoding="utf-8"))
conf = d["contributes"]["configuration"]
changed = False
for c in (conf if isinstance(conf, list) else [conf]):
    for k in ("claudeCode.useTerminal",):
        prop = c.get("properties", {}).get(k)
        if prop is not None and prop.get("scope") != "machine":
            prop["scope"] = "machine"; changed = True
if changed:
    tmp = p + ".tmp"
    json.dump(d, open(tmp, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    os.replace(tmp, p)
PY2
for d in "$EXT"/*(N/); do                                # nothing else in this instance
  [[ "${d:t}" == "$ext_name" ]] || rm -rf "$d"
done
rm -f "$EXT/extensions.json" "$EXT/.obsolete" 2>/dev/null || true   # VS Code rescans the folder

# `claude` typed in this window's terminal (or the extension's terminal mode) = the local launcher.
mkdir -p "$BASE/bin" "$BASE/no-cloud"
print -r -- "#!/bin/zsh
# generated by local-vscode: in the «$which» window \`claude\` is the LOCAL one
exec \"$HARNESS_HOME/bin/claude-local\" $([[ $which == lab ]] && print -- --lab) \"\$@\"" > "$BASE/bin/claude"
chmod 755 "$BASE/bin/claude"
rm -rf "$DATA/logs"/*(N/m+1)                              # VS Code logs older than a day (paths, tool output)

# 2. Settings: ours always win; the user's own UI choices in this instance are kept.
/usr/bin/python3 -I - "$DATA/User/settings.json" "$which" "$wrapper" "$conf" "$title" "$bar" "$bar2" "$BASE" <<'PY'
import json, os, re, sys, time
path, which, wrapper, conf, title, bar, bar2, base = sys.argv[1:]


def jsonc(text):
    """VS Code settings are JSONC: // and /* */ comments outside strings, trailing commas."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        ch = text[i]
        if in_str:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1]); i += 2; continue
            if ch == '"':
                in_str = False
        elif ch == '"':
            in_str = True; out.append(ch)
        elif text.startswith("//", i):
            j = text.find("\n", i); i = n if j < 0 else j; continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2); i = n if j < 0 else j + 2; continue
        else:
            out.append(ch)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)) or "{}")


cur = {}
if os.path.exists(path):
    try:
        cur = jsonc(open(path, encoding="utf-8").read())
    except ValueError as e:
        sys.exit(f"не разобрать настройки окна ({path}): {e}. Исправь или удали файл — сам не трогаю.")
env = [
    {"name": "CLAUDE_CONFIG_DIR", "value": conf},
    {"name": "ANTHROPIC_BASE_URL", "value": "http://127.0.0.1:1234"},
    {"name": "ANTHROPIC_AUTH_TOKEN", "value": "lmstudio-local"},
    {"name": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "value": "1"},
    {"name": "DISABLE_TELEMETRY", "value": "1"},
    {"name": "DISABLE_AUTOUPDATER", "value": "1"},
]
forced = {
    # the window's Claude = claude-local (sandbox, pinned binary, local model)
    "claudeCode.claudeProcessWrapper": wrapper,
    "claudeCode.environmentVariables": env,
    "claudeCode.disableLoginPrompt": True,
    "claudeCode.allowDangerouslySkipPermissions": False,
    "claudeCode.hideOnboarding": True,
    # nothing of this window goes anywhere
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": False,
    "update.mode": "none",
    "update.showReleaseNotes": False,
    "extensions.autoUpdate": False,
    "extensions.autoCheckUpdates": False,
    "extensions.ignoreRecommendations": True,
    "workbench.enableExperiments": False,
    "workbench.settings.enableNaturalLanguageSearch": False,
    "chat.disableAIFeatures": True,
    "git.autofetch": False,
    "npm.fetchOnlinePackageInfo": False,
    "json.schemaDownload.enable": False,
    "settingsSync.keybindingsPerPlatform": True,
    "security.workspace.trust.enabled": False,
    # a folder must not run anything by itself (tasks on folder open) or switch Claude to terminal mode
    "task.allowAutomaticTasks": "off",
    "claudeCode.useTerminal": False,
    # this window's terminals: `claude` = the local launcher; a cloud CLI, if ever installed, fails closed
    "terminal.integrated.env.osx": {"PATH": base + "/bin:${env:PATH}", "CLAUDE_CONFIG_DIR": base + "/no-cloud",
                                    "ANTHROPIC_BASE_URL": "http://127.0.0.1:9"},
    # you always see which window this is
    "window.title": title + " · ${rootName}${separator}${activeEditorShort}",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": bar, "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": bar2, "titleBar.inactiveForeground": "#dddddd",
        "statusBar.background": bar, "statusBar.foreground": "#ffffff",
    },
}
defaults = {
    "claudeCode.preferredLocation": "panel",
    "workbench.startupEditor": "none",
    "files.autoSave": "afterDelay",
}
if which == "work":
    # the work window itself stays offline too: no update checks, no marketplace, and no remote images
    # in Markdown previews (a report.md with ![](https://…?data) would leak on preview)
    forced.update({"http.proxy": "http://127.0.0.1:9", "http.proxySupport": "override", "http.noProxy": []})
else:
    # lab: VS Code itself is not sandboxed — an opened file must not ride along into an online chat
    forced.update({"claudeCode.attachOpenFile": False, "claudeCode.attachSelection": False})
for k, v in defaults.items():
    cur.setdefault(k, v)
cur.update(forced)
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(cur, f, ensure_ascii=False, indent=2)
os.replace(tmp, path)
PY

(( setup_only )) && { print "✔ экземпляр $which готов: $BASE"; exit 0; }

# 3. Folder. Lab without a folder → its own playground; client folders never open in the lab.
if [[ -z "$folder" && $which == lab ]]; then
  folder="$HOME/Лаборатория"; mkdir -p "$folder"
fi
file=""
if [[ -n "$folder" && -f "$folder" ]]; then        # a file was dropped on the app: open its folder + the file
  file="${folder:A}"; folder="${file:h}"
fi
if [[ -n "$folder" ]]; then
  folder="${folder:A}"
  [[ -d "$folder" ]] || die "нет такой папки: $folder"
  msg=$(cd "$folder" && CLAUDE_LOCAL_UI=vscode "$HARNESS_HOME/bin/claude-local" $([[ $which == lab ]] && print -- --lab) \
          --check-folder 2>&1 >/dev/null) || die "${msg#✖ claude-local: }"
fi

# 4. Model: load in the background while the window opens (the chat waits for it if needed).
if [[ $which == lab ]]; then
  ( "$HARNESS_HOME/bin/claude-local" --lab --preload >"$BASE/preload.log" 2>&1 & ) 2>/dev/null
else
  ( "$HARNESS_HOME/bin/claude-local" --preload >"$BASE/preload.log" 2>&1 & ) 2>/dev/null
fi

# 5. Open. Clean env: inside a VS Code terminal VSCODE_IPC_HOOK_CLI would send the folder to the MAIN
#    VS Code (with the cloud Claude) instead of starting this instance.
for v in ${(k)parameters[(I)VSCODE_*]} ${(k)parameters[(I)ELECTRON_*]}; do unset $v; done
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_TELEMETRY=1
export GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false \
       GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=/dev/null \
       GIT_CONFIG_KEY_2=safe.bareRepository GIT_CONFIG_VALUE_2=explicit
args=(--user-data-dir "$DATA" --extensions-dir "$EXT" --crash-reporter-directory "$BASE/crashes")
[[ $which == work ]] && args+=(--proxy-server=127.0.0.1:9)   # renderer/webviews/previews: nothing goes out
[[ -n "$folder" ]] && args+=("$folder")
[[ -n "$file" ]] && args+=("$file")
"$CODE" "${args[@]}" >/dev/null 2>&1 &!
exit 0
