# models.env — which local models claude-local runs. Sourced by bin/claude-local and tests/check-hashes.sh.
# Filled by the installing agent for THIS Mac (02_ВЫБОР-МОДЕЛЕЙ.md). One model is in memory at a time.
#   *_KEY   LM Studio model key (`lms ls`), *_ID  API identifier Claude Code sees, *_CTX context window,
#   *_REPO  Hugging Face repo the weights came from (for tests/check-hashes.sh), *_LABEL  shown to the user.
# Context: MLX allocates the KV cache lazily (big CTX costs memory only when used);
#          llama.cpp (GGUF) reserves the whole KV cache at load — keep GGUF CTX moderate.
# Defaults below = the tested pair for a 48 GB Mac (Apple Silicon), November 2026.

WORK_KEY="qwen3.8-27b-mlx"
WORK_ID="qwen-work"
WORK_CTX=131072
WORK_LABEL="Qwen3.8-27B · рабочая"
WORK_REPO="lmstudio-community/Qwen3.8-27B-MLX-6bit"

LAB_KEY="huihui-qwen3.8-27b-abliterated-cc"        # template-patched copy (see 02_ВЫБОР-МОДЕЛЕЙ.md, «Шаблон чата»)
LAB_ID="qwen-lab"
LAB_CTX=65536
LAB_LABEL="Qwen3.8-27B без фильтров · лаборатория"
LAB_REPO="huihui-ai/Huihui-Qwen3.8-27B-abliterated-GGUF"
